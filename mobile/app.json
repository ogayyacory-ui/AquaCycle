{
  "expo": {
    "name": "AquaCycle",
    "slug": "aquacycle",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aquacycle",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      ["expo-location", { "locationWhenInUsePermission": "Allow AquaCycle to use your location for local weather." }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}